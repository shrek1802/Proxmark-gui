#!/usr/bin/env bash
set -Eeuo pipefail
PAYLOAD=/usr/share/proxmark3-workshop/payload
APPDIR="$HOME/.local/share/proxmark3-workshop-gui"
installed="Not installed"
if [[ -f "$APPDIR/proxmark_gui.py" ]]; then
  v=$(grep -m1 "^VERSION=" "$APPDIR/proxmark_gui.py" 2>/dev/null | sed -E "s/.*['\"]([^'\"]+)['\"].*/\1/" || true)
  [[ -n "$v" ]] && installed="v$v"
fi
if ! command -v zenity >/dev/null 2>&1; then
  x-terminal-emulator -e bash -lc "echo 'Zenity is required for the graphical setup menu.'; echo 'Install it with: sudo apt install zenity'; read -p 'Press Enter to close'" || true
  exit 1
fi
choice=$(zenity --list --radiolist --width=650 --height=350 \
  --title="TagForge Studio Setup" \
  --text="Existing installation: $installed\n\nChoose what you want to do." \
  --column="Select" --column="Action" --column="What it does" \
  TRUE "UPDATE TAGFORGE GUI" "Updates TagForge only; preserves RRG, firmware, My Keys and user data" \
  FALSE "FULL INSTALL / REPAIR" "Dependencies, RRG build, USB rules, hardware target and TagForge Studio" \
  FALSE "LAUNCH TAGFORGE" "Open the currently installed TagForge Studio") || exit 0
case "$choice" in
  "UPDATE TAGFORGE GUI") exec "$PAYLOAD/update-gui-only.sh" ;;
  "FULL INSTALL / REPAIR") exec "$PAYLOAD/setup-installer.sh" ;;
  "LAUNCH TAGFORGE")
    if command -v proxmark3-gui >/dev/null 2>&1; then exec proxmark3-gui; fi
    if [[ -x "$HOME/.local/bin/proxmark3-gui" ]]; then exec "$HOME/.local/bin/proxmark3-gui"; fi
    zenity --error --title="TagForge Studio" --text="TagForge Studio is not installed yet. Choose Update TagForge GUI or Full Install / Repair first." ;;
esac
