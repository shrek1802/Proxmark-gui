#!/usr/bin/env bash
set -e
# Debian maintainer scripts run as root, outside the desktop user's graphical
# session. Starting a GUI here is unreliable on Ubuntu/Wayland and can silently
# fail. Instead install a normal Applications-menu launcher and let the user
# start the setup in their own session.
if [ "${1:-}" = "configure" ]; then
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
exit 0
